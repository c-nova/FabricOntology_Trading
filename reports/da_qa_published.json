      "execution_index": 0,
      "sql": "SELECT\n    e.event_id,\n    e.primary_sector,\n    e.direction,\n    e.severity,\n    e.start_date,\n    e.end_date,\n    COUNT(DISTINCT f.effect_id) AS effect_id_count,\n    SUM(f.delta_ebitda_full_jpy) AS total_delta_ebitda_full_jpy,\n    SUM(f.delta_management_jpy) AS total_delta_management_jpy,\n    COUNT(*) OVER () AS total_event_count\nFROM dbo.semantic_risk_events AS e\nINNER JOIN dbo.semantic_event_financial_effects AS f\n    ON f.event_id = e.event_id\nWHERE e.start_date <= '2026-09-30'\n  AND e.end_date >= '2025-10-01'\nGROUP BY\n    e.event_id,\n    e.primary_sector,\n    e.direction,\n    e.severity,\n    e.start_date,\n    e.end_date\nORDER BY e.event_id",
